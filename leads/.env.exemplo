# Copie para .env e preencha (cp .env.exemplo .env && nano .env). Nunca mande este arquivo por chat.
DOMINIO=leads.weap.com.br
DB_PASSWORD=TROQUE_POR_UMA_SENHA_LONGA
RECEITA_UFS=PR,SP

# Banco do agente (weap_sdr, servidor do n8n) pela rede interna da Hetzner. Pode deixar vazio no começo.
AGENTE_DB_HOST=
AGENTE_DB_PORT=5432
AGENTE_DB_NAME=weap_sdr
AGENTE_DB_USER=leads_leitura
AGENTE_DB_PASSWORD=

# CRM (leads.weap.com.br). Gere a chave com: openssl rand -hex 32
CRM_SECRET_KEY=TROQUE_POR_UMA_CHAVE_LONGA
CRM_ADMIN_EMAIL=marcio@weap.com.br
CRM_ADMIN_SENHA=TROQUE_POR_UMA_SENHA
# Banco do agente em formato URL (opcional): postgresql+psycopg://leads_leitura:SENHA@IP_INTERNO:5432/weap_sdr
AGENTE_DB_URL=
# Evolution API, para a tela de números mostrar se cada número está conectado.
# Um servidor por item, separados por ";": endereço|chave global da Evolution
EVOLUTION_APIS=https://zap7.mercadonet.com.br|COLOQUE_A_CHAVE;https://OUTRA_EVOLUTION|COLOQUE_A_CHAVE
