    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH up AS (\n  INSERT INTO sdr_leads (chave, telefone, instancia, nome_empresa, especialidades, nicho, planilha, status,\n                         primeira_mensagem, ultima_mensagem_enviada, contatos_enviados, ultimo_contato_em)\n  SELECT sdr_chave($1), $1, $2, nullif($3, ''), nullif($4, ''), sdr_nicho($4), nullif($5, ''), 'contatado', $6, $6, 1, now()\n   WHERE sdr_chave($1) IS NOT NULL\n  ON CONFLICT (chave) DO UPDATE SET\n     instancia = EXCLUDED.instancia,\n     nome_empresa = coalesce(sdr_leads.nome_empresa, EXCLUDED.nome_empresa),\n     especialidades = coalesce(sdr_leads.especialidades, EXCLUDED.especialidades),\n     nicho = CASE WHEN sdr_leads.nicho = 'geral' THEN EXCLUDED.nicho ELSE sdr_leads.nicho END,\n     planilha = coalesce(sdr_leads.planilha, EXCLUDED.planilha),\n     primeira_mensagem = coalesce(sdr_leads.primeira_mensagem, EXCLUDED.primeira_mensagem),\n     ultima_mensagem_enviada = EXCLUDED.ultima_mensagem_enviada,\n     contatos_enviados = sdr_leads.contatos_enviados + 1,\n     ultimo_contato_em = now(), atualizado_em = now()\n  RETURNING id, nicho\n),\nmsg AS (\n  INSERT INTO sdr_mensagens (lead_id, instancia, direcao, autor, texto)\n  SELECT id, $2, 'out', 'disparo', $6 FROM up\n)\nSELECT up.id AS lead_id, m.id AS midia_id, m.tipo, m.url, m.legenda\n  FROM up\n  LEFT JOIN LATERAL (\n    SELECT * FROM sdr_midias\n     WHERE ativo AND usar_no_disparo AND nicho IN (up.nicho, 'geral')\n       AND (SELECT valor FROM sdr_config WHERE chave = 'midia_no_disparo') = 'sim'\n     ORDER BY (nicho = up.nicho) DESC, random() LIMIT 1\n  ) m ON true;",
        "options": {
          "queryReplacement": "={{ (() => { const l = $('Loop Over Items').first().json; let msg = ''; try { msg = $('Message a model').first().json.message.content.messages.map(m => m.message).join('\\n'); } catch (e) {} if (!msg) msg = $('Envia MSG Texto').first().json.message?.conversation || '[mensagem padrão do disparo]'; return [ String(l.telefone || ''), String($('Dados_Evolution').first().json.instancia || ''), String(l.nome_empresa || ''), String(l.especialidades || ''), (() => { try { return String($('Get row(s) in sheet').params.sheetName.cachedResultName || ''); } catch (e) { return ''; } })(), msg ]; })() }}"
        }
      },
