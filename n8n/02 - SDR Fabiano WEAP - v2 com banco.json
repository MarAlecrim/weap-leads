        "operation": "executeQuery",
        "query": "SELECT coalesce(bool_or(l.opt_out OR sdr_em_conversa(l.status)), false) AS pular,\n       max(CASE WHEN l.status = 'bot' THEN 'número é robô ou atendimento automático'\n                WHEN l.opt_out THEN 'pediu para não receber'\n                WHEN sdr_em_conversa(l.status) THEN 'já está conversando (' || l.status || ')' END) AS motivo,\n       coalesce(max(l.contatos_enviados), 0) AS contatos,\n       max(l.primeira_mensagem) AS primeira_mensagem,\n       (SELECT responsavel_nome FROM sdr_instancias WHERE instancia = $2) AS responsavel\n  FROM sdr_leads l\n WHERE l.chave = sdr_chave($1);",
        "options": {
          "queryReplacement": "={{ [ String($('Loop Over Items').first().json.telefone || ''), String($('Dados_Evolution').first().json.instancia || '') ] }}"
        }
