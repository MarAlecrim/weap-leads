    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH up AS (\n  INSERT INTO sdr_leads (chave, telefone, instancia, nome_empresa, especialidades, nicho, planilha, status,\n                         primeira_mensagem, ultima_mensagem_enviada, contatos_enviados, ultimo_contato_em)\n  SELECT sdr_chave($1), $1, nullif($2, ''), nullif($3, ''), nullif($4, ''), sdr_nicho($4), nullif($5, ''), 'contatado',\n         nullif($6, ''), nullif($6, ''), 1, now()\n   WHERE sdr_chave($1) IS NOT NULL\n  ON CONFLICT (chave) DO NOTHING\n  RETURNING id\n)\nINSERT INTO sdr_mensagens (lead_id, instancia, direcao, autor, texto)\nSELECT id, nullif($2, ''), 'out', 'disparo', $6 FROM up WHERE $6 <> ''\nRETURNING lead_id;",
        "options": {
          "queryReplacement": "={{ [ String($json.telefone || ''), String($('Qual número disparou').first().json.instancia || ''), String($json.nome_empresa || ''), String($json.especialidades || ''), (() => { try { return String($('Lê planilha').params.sheetName.cachedResultName || ''); } catch (e) { return ''; } })(), String($json.mensagem || '') ] }}"
        }
